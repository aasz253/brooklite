# Copy this file to .env.local and fill in the values.
# .env.local is listed in .gitignore and must NEVER be committed.

# Supabase project URL and anon key — safe to expose to the browser.
# Get them from: Supabase Dashboard → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Service-role key — SERVER-SIDE ONLY. Never expose to the browser.
# Get it from: Supabase Dashboard → Project Settings → API
SUPABASE_SERVICE_ROLE_KEY=

# Optional: the site URL used for canonical URLs / structured data.
NEXT_PUBLIC_SITE_URL=http://localhost:3000